# GlowDerma Store — configuration template.
# Copy to .env for local development. Use your host's secret manager in production.
# Every value below is a PLACEHOLDER. Never commit a real .env.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Public URL of the site. Must be https:// in production.
APP_URL=http://localhost:3000
# Set to true only when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false

# PostgreSQL 14+ (16 recommended). Production: add ?sslmode=verify-full
DATABASE_URL=postgres://glowderma:change-me@127.0.0.1:5432/glowderma_dev
DATABASE_POOL_MAX=10
# Separate, disposable database used by `npm test` and `npm run test:e2e` (it is wiped on every run).
TEST_DATABASE_URL=postgres://glowderma:change-me@127.0.0.1:5432/glowderma_test

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters

# Payments: "sandbox" (built-in test gateway, no money moves) or "razorpay".
PAYMENT_PROVIDER=sandbox
SANDBOX_PAYMENT_SECRET=replace-with-64-random-hex-characters
# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks). Use TEST keys until go-live sign-off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Prescription uploads are stored here (outside the web root). Use an encrypted volume in production.
PRESCRIPTION_STORAGE_DIR=./storage/prescriptions
PRESCRIPTION_MAX_BYTES=5000000
# Leave false until licences, a registered pharmacist and legal review are confirmed (see SECURITY_CHECKLIST.md).
ENABLE_PRESCRIPTION_ORDERING=false

# Email: "database" (dev: stored in outbound_emails), "log", or "webhook" (production: your mail provider's HTTP API or a relay).
MAIL_DRIVER=database
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM=GlowDerma Store <no-reply@example.invalid>

# Analytics stays off until configured AND covered by your privacy notice / consent: "", "plausible" or "ga4".
ANALYTICS_PROVIDER=
ANALYTICS_ID=

LOG_LEVEL=info

# Development seed only: password for the demo accounts created by `npm run db:seed`.
SEED_DEMO_PASSWORD=GlowDemo#2026
